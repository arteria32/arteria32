<mujocoinclude>
  <!--
    RG2 v2 kinematics (ported from the URDF structure) using RG2 v1 geometry params.
    NOTE: You provided a single monolithic STL, so the *visual* mesh is attached to the base.
    The moving finger links use collision-proxy boxes so joints/contacts work correctly.
  -->
  <body name="rg2_v2">
    <!-- static visual shell -->
    <geom class="visual" mesh="rg2_v2_mesh"/>

    <!-- base collision proxy (tune as needed) -->
    <geom class="collision" size="0.03 0.03 0.04" pos="0 0 0.06"/>

    <!-- body fixed offset from bracket: origin[single_bracket] -->
    <body name="rg2_v2_body" pos="0 0 0.05">
      <!-- grasp frame (site) -->
      <site name="rg2_v2_grasp_frame" pos="0 0 0.14" size="0.005" rgba="1 0 0 1"/>

      <!-- Finger 1 (master) -->
      <body name="rg2_v2_finger_1_origin" euler="0 0 0">
        <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>

        <!-- moment arm joint (master) -->
        <body name="rg2_v2_finger_1_moment_arm" pos="-0.017 0 0.055" euler="0 -0.772 0">
          <joint name="rg2_v2_gripper_joint" type="hinge" axis="0 1 0" range="0 1.3"
                 damping="0.4" armature="0.02" frictionloss="0.02"/>
          <!-- proxy geom for linkage mass/contact -->
          <geom class="collision" size="0.004 0.012 0.004" pos="-0.01 0 0"/>
        </body>

        <!-- truss arm joint -->
        <body name="rg2_v2_finger_1_truss_arm" pos="-0.0075 0 0.0715" euler="0 -0.772 0">
          <joint name="rg2_v2_finger_1_truss_arm_joint" type="hinge" axis="0 1 0" range="0 1.3"
                 damping="0.3" armature="0.01" frictionloss="0.01"/>
          <geom class="collision" size="0.004 0.012 0.004" pos="-0.01 0 0"/>

          <!-- finger tip joint -->
          <body name="rg2_v2_finger_1_finger_tip" pos="-0.0256 0 0.04868" euler="0 0.772 0">
            <joint name="rg2_v2_finger_1_finger_tip_joint" type="hinge" axis="0 -1 0" range="0 1.3"
                   damping="0.25" armature="0.01" frictionloss="0.01"/>

            <!-- main fingertip contact proxy -->
            <geom class="collision" size="0.006 0.010 0.018" pos="-0.012 0 0.015"/>
          </body>
        </body>
      </body>

      <!-- Finger 2 (mirror): yaw pi -->
      <body name="rg2_v2_finger_2_origin" euler="0 0 3.141592653589793">
        <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>

        <body name="rg2_v2_finger_2_moment_arm" pos="-0.017 0 0.055" euler="0 -0.772 0">
          <joint name="rg2_v2_gripper_mirror_joint" type="hinge" axis="0 1 0" range="0 1.3"
                 damping="0.4" armature="0.02" frictionloss="0.02"/>
          <geom class="collision" size="0.004 0.012 0.004" pos="-0.01 0 0"/>
        </body>

        <body name="rg2_v2_finger_2_truss_arm" pos="-0.0075 0 0.0715" euler="0 -0.772 0">
          <joint name="rg2_v2_finger_2_truss_arm_joint" type="hinge" axis="0 1 0" range="0 1.3"
                 damping="0.3" armature="0.01" frictionloss="0.01"/>
          <geom class="collision" size="0.004 0.012 0.004" pos="-0.01 0 0"/>

          <body name="rg2_v2_finger_2_finger_tip" pos="-0.0256 0 0.04868" euler="0 0.772 0">
            <joint name="rg2_v2_finger_2_finger_tip_joint" type="hinge" axis="0 -1 0" range="0 1.3"
                   damping="0.25" armature="0.01" frictionloss="0.01"/>
            <geom class="collision" size="0.006 0.010 0.018" pos="-0.012 0 0.015"/>
          </body>
        </body>
      </body>
    </body>
  </body>
</mujocoinclude>
