<mujocoinclude>
  <!-- Rigid (single-mesh) RG2 v2 body. Attach under your robot wrist body. -->
  <body name="rg2_v2">
    <geom class="visual" mesh="rg2_v2_mesh"/>

    <!-- Simple collision proxies (tune pos/size to match your mesh) -->
    <geom class="collision" size="0.03 0.03 0.04" pos="0 0 0.06"/>
    <geom class="collision" size="0.01 0.035 0.01" pos="0.04 0 0.12"/>
    <geom class="collision" size="0.01 0.035 0.01" pos="-0.04 0 0.12"/>
  </body>
</mujocoinclude>
