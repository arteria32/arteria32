<mujocoinclude>
  <equality>
    <!-- Mimic relationships from the URDF (mimic multiplier=1) -->
    <joint joint1="rg6_gripper_joint" joint2="rg6_gripper_mirror_joint" polycoef="0 1 0 0 0"
           solref="0.03 1" solimp="0.9 0.95 0.001 0.5 2"/>

    <joint joint1="rg6_gripper_joint" joint2="rg6_finger_1_truss_arm_joint" polycoef="0 1 0 0 0"
           solref="0.03 1" solimp="0.9 0.95 0.001 0.5 2"/>
    <joint joint1="rg6_gripper_joint" joint2="rg6_finger_1_finger_tip_joint" polycoef="0 1 0 0 0"
           solref="0.03 1" solimp="0.9 0.95 0.001 0.5 2"/>
    <joint joint1="rg6_gripper_joint" joint2="rg6_finger_1_safety_shield_joint" polycoef="0 1 0 0 0"
           solref="0.03 1" solimp="0.9 0.95 0.001 0.5 2"/>

    <joint joint1="rg6_gripper_joint" joint2="rg6_finger_2_truss_arm_joint" polycoef="0 1 0 0 0"
           solref="0.03 1" solimp="0.9 0.95 0.001 0.5 2"/>
    <joint joint1="rg6_gripper_joint" joint2="rg6_finger_2_finger_tip_joint" polycoef="0 1 0 0 0"
           solref="0.03 1" solimp="0.9 0.95 0.001 0.5 2"/>
    <joint joint1="rg6_gripper_joint" joint2="rg6_finger_2_safety_shield_joint" polycoef="0 1 0 0 0"
           solref="0.03 1" solimp="0.9 0.95 0.001 0.5 2"/>
  </equality>

  <actuator>
    <!-- Drive a single joint; the rest follow via equality constraints. -->
    <!-- Lower gains + add kv + clamp force to prevent oscillation -->
    <position name="rg6_open_close" joint="rg6_gripper_joint"
              kp="40" kv="5"
              ctrlrange="0 1.3" forcerange="-50 50"/>
  </actuator>
</mujocoinclude>
