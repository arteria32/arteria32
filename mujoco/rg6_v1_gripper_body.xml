<mujocoinclude>
  <!-- Attach this body under your robot wrist/end-effector body -->
  <body name="rg6">
    <!-- bracket (link: gripper_bracket) -->
    <geom class="visual" mesh="rg6_single_bracket"/>
    <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>

    <!-- body (link: gripper_body), fixed joint at origin[single_bracket] -->
    <body name="rg6_body" pos="0 0 0.051">
      <geom class="visual" mesh="rg6_body" rgba="0.85 0.85 0.85 1"/>
      <inertial pos="0 0 0" mass="0.78" diaginertia="0.001 0.001 0.001"/>

      <!-- grasp frame -->
      <site name="rg6_grasp_frame" pos="0 0 0.19" size="0.005" rgba="1 0 0 1"/>

      <!-- Finger 1 (master) -->
      <body name="rg6_finger_1_origin" euler="0 0 0">
        <inertial pos="0 0 0" mass="0.001" diaginertia="0.00001 0.00001 0.00001"/>

        <body name="rg6_finger_1_moment_arm" pos="-0.0238 0 0.066" euler="0 -0.49 0">
          <joint name="rg6_gripper_joint" type="hinge" axis="0 1 0" range="0 1.3"
                 damping="0.4" armature="0.02" frictionloss="0.02"/>
          <geom class="visual" mesh="rg6_moment_arm"/>
          <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
        </body>

        <body name="rg6_finger_1_truss_arm" pos="-0.0105 0 0.0891" euler="0 -0.49 0">
          <joint name="rg6_finger_1_truss_arm_joint" type="hinge" axis="0 1 0" range="0 1.3"
                 damping="0.3" armature="0.01" frictionloss="0.01"/>
          <geom class="visual" mesh="rg6_truss_arm"/>
          <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>

          <body name="rg6_finger_1_finger_tip" pos="-0.05503 0 0.05807" euler="0 0.49 0">
            <joint name="rg6_finger_1_finger_tip_joint" type="hinge" axis="0 -1 0" range="0 1.3"
                   damping="0.25" armature="0.01" frictionloss="0.01"/>
            <geom class="visual" mesh="rg6_finger_tip"/>
            <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>

            <body name="rg6_finger_1_safety_shield" pos="-0.00665 0 -0.01155" euler="0 -0.49 0">
              <joint name="rg6_finger_1_safety_shield_joint" type="hinge" axis="0 1 0" range="0 1.3"
                     damping="0.2" armature="0.005" frictionloss="0.005"/>
              <geom class="visual" mesh="rg6_safety_shield" rgba="0.25 0.25 0.25 1"/>
              <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
            </body>

            <body name="rg6_finger_1_flex_finger" pos="0.0098 0 0.0218">
              <geom class="visual" mesh="rg6_flex_finger" rgba="0.25 0.25 0.25 1"/>
              <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
              <geom class="collision" size="0.007 0.012 0.02" pos="-0.02 0 0.02"/>
            </body>
          </body>
        </body>
      </body>

      <!-- Finger 2 (mirror): yaw pi -->
      <body name="rg6_finger_2_origin" euler="0 0 3.141592653589793">
        <inertial pos="0 0 0" mass="0.001" diaginertia="0.00001 0.00001 0.00001"/>

        <body name="rg6_finger_2_moment_arm" pos="-0.0238 0 0.066" euler="0 -0.49 0">
          <joint name="rg6_gripper_mirror_joint" type="hinge" axis="0 1 0" range="0 1.3"
                 damping="0.4" armature="0.02" frictionloss="0.02"/>
          <geom class="visual" mesh="rg6_moment_arm"/>
          <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
        </body>

        <body name="rg6_finger_2_truss_arm" pos="-0.0105 0 0.0891" euler="0 -0.49 0">
          <joint name="rg6_finger_2_truss_arm_joint" type="hinge" axis="0 1 0" range="0 1.3"
                 damping="0.3" armature="0.01" frictionloss="0.01"/>
          <geom class="visual" mesh="rg6_truss_arm"/>
          <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>

          <body name="rg6_finger_2_finger_tip" pos="-0.05503 0 0.05807" euler="0 0.49 0">
            <joint name="rg6_finger_2_finger_tip_joint" type="hinge" axis="0 -1 0" range="0 1.3"
                   damping="0.25" armature="0.01" frictionloss="0.01"/>
            <geom class="visual" mesh="rg6_finger_tip"/>
            <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>

            <body name="rg6_finger_2_safety_shield" pos="-0.00665 0 -0.01155" euler="0 -0.49 0">
              <joint name="rg6_finger_2_safety_shield_joint" type="hinge" axis="0 1 0" range="0 1.3"
                     damping="0.2" armature="0.005" frictionloss="0.005"/>
              <geom class="visual" mesh="rg6_safety_shield" rgba="0.25 0.25 0.25 1"/>
              <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
            </body>

            <body name="rg6_finger_2_flex_finger" pos="0.0098 0 0.0218">
              <geom class="visual" mesh="rg6_flex_finger" rgba="0.25 0.25 0.25 1"/>
              <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
              <geom class="collision" size="0.007 0.012 0.02" pos="-0.02 0 0.02"/>
            </body>
          </body>
        </body>
      </body>

      <geom class="collision" size="0.03 0.03 0.04" pos="-0.01 0 0.06"/>
    </body>
  </body>
</mujocoinclude>
